GEMINI_API_KEY=dein-gemini-key
GEMINI_MODEL=gemini-3.6-flash
DISCORD_BOT_TOKEN=dein-bot-token
# Developer Portal -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=dein-client-secret
PORT=3001
# Ersatzmodelle (Komma-getrennt), falls das Hauptmodell überlastet ist
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash
# Denk-Stufe: minimal (schnell), low, medium, high – leer = Modell-Standard
GEMINI_THINKING=minimal
